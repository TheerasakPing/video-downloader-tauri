import React, { useCallback } from 'react';
import { Download, Pause, Play, X } from 'lucide-react';
import { AppState, AppAction } from '../../hooks/useAppState';

interface DownloadPanelProps {
  state: AppState;
  onStartDownload: () => Promise<void>;
  onPause: () => Promise<void>;
  onResume: () => Promise<void>;
  onCancel: () => Promise<void>;
}

export const DownloadPanel: React.FC<DownloadPanelProps> = ({
  state,
  
  onStartDownload,
  onPause,
  onResume,
  onCancel,
}) => {
  const handleStartDownload = useCallback(async () => {
    try {
      await onStartDownload();
    } catch (error) {
      console.error('Download failed:', error);
    }
  }, [onStartDownload]);

  const handlePause = useCallback(async () => {
    try {
      await onPause();
    } catch (error) {
      console.error('Pause failed:', error);
    }
  }, [onPause]);

  const handleResume = useCallback(async () => {
    try {
      await onResume();
    } catch (error) {
      console.error('Resume failed:', error);
    }
  }, [onResume]);

  const handleCancel = useCallback(async () => {
    try {
      await onCancel();
    } catch (error) {
      console.error('Cancel failed:', error);
    }
  }, [onCancel]);

  const { download } = state;

  return (
    <div className="space-y-4">
      <div className="flex gap-2">
        {!download.isDownloading ? (
          <button
            onClick={handleStartDownload}
            className="flex items-center gap-2 px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-lg transition-colors"
          >
            <Download className="w-4 h-4" />
            Start Download
          </button>
        ) : (
          <>
            <button
              onClick={download.isPaused ? handleResume : handlePause}
              className="flex items-center gap-2 px-4 py-2 bg-yellow-600 hover:bg-yellow-700 text-white rounded-lg transition-colors"
            >
              {download.isPaused ? (
                <>
                  <Play className="w-4 h-4" />
                  Resume
                </>
              ) : (
                <>
                  <Pause className="w-4 h-4" />
                  Pause
                </>
              )}
            </button>
            <button
              onClick={handleCancel}
              className="flex items-center gap-2 px-4 py-2 bg-red-600 hover:bg-red-700 text-white rounded-lg transition-colors"
            >
              <X className="w-4 h-4" />
              Cancel
            </button>
          </>
        )}
      </div>

      {download.isDownloading && (
        <div className="space-y-2">
          <div className="text-sm text-gray-600 dark:text-gray-400">
            Episode {download.currentEpisode} of {download.totalSelected}
          </div>
          <div className="space-y-1">
            <div className="text-xs text-gray-500">
              Completed: {download.completedEpisodes.length} | Failed: {download.failedEpisodes.length}
            </div>
          </div>
        </div>
      )}
    </div>
  );
};

export default DownloadPanel;
